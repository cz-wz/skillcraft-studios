        "subtitle": "Guided conversations for empowered community members",
        "participantName": "Community Member",
        "description": "Join us every other [Day] at [location] and [time] where we will learn and practice general coaching skills for effectively guiding friends, family, and community members.",
        "badges": ["Event", "Adults", "College Students", "High Schoolers", "Middle Schoolers"],
        "image": "",
        "imageAlt": "",
        "favicon": "",        
